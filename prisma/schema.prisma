// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique @db.VarChar(100)
  name      String? @db.VarChar(100)
  avatarUrl String?

  accounts              Account[]
  memberships           Membership[]
  createdOrgs           Organization[] @relation("OrganizationCreatedBy")
  connectedIntegrations Integration[]  @relation("IntegrationConnectedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Organization {
  id        String @id @default(cuid())
  name      String @db.VarChar(100)
  slug      String @unique @db.VarChar(100)
  createdBy String
  onboardingCompleted Boolean @default(false)

  creator            User               @relation("OrganizationCreatedBy", fields: [createdBy], references: [id])
  memberships        Membership[]
  integrations       Integration[]
  repositories       Repository[]
  repoScanConfigs    RepoScanConfig[]
  branchScanPolicies BranchScanPolicy[]
  pullRequests       PullRequest[]
  scans              Scan[]
  findings           Finding[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role             @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  lastAccessedAt DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

enum MembershipStatus {
  ACTIVE
  INVITED
}

enum Role {
  ADMIN
  REVIEWER
  VIEWER
}

model Account {
  id                String   @id @default(cuid())
  provider          Provider
  providerAccountId String
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  userId            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

enum Provider {
  GITHUB
  GITLAB
}

model Integration {
  id             String           @id @default(cuid())
  organizationId String
  source         Provider
  credentialKind CredentialKind   @default(GROUP_TOKEN)
  state          IntegrationState @default(ACTIVE)

  // --- GitLab-only fields — nullable, unused when source = GITHUB ---
  instanceUrl    String?    @db.Text
  encryptedToken String?    @db.Text
  expiresAt      DateTime?
  tokenKind      TokenKind?
  tokenUsername  String?    @db.Text
  groupsCache    Json?

  // --- GitHub App-only fields — nullable, unused when source = GITLAB ---
  // installationId is the durable credential here: there is no per-org
  // secret to store, just this id + the one shared App private key (env
  // config) needed to mint short-lived installation access tokens on demand.
  installationId    String? @unique
  installationLogin String? @db.Text
  appSlug           String? @db.Text

  connectedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?        @relation("IntegrationConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  repositories Repository[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, source])
  @@map("integrations")
}

enum CredentialKind {
  GROUP_TOKEN
  OAUTH
  INSTALLATION
}

enum TokenKind {
  GROUP
  PERSONAL
}

enum IntegrationState {
  ACTIVE
  EXPIRING_SOON
  TOKEN_EXPIRED
  INVALID
  // GitHub App installation only: the org's GitHub restricts installs to
  // owners, a non-owner requested install, and a separate GitHub-side
  // owner approval is still pending. No webhook ingestion exists yet
  // (Fase 4) to detect that approval automatically — this state persists
  // until an admin re-runs the install flow after approval.
  PENDING_APPROVAL
}

// Short-lived, single-use record bridging the GitHub App installation
// redirect round trip (Critiq -> github.com -> Critiq callback). Stored in
// Postgres rather than Redis — this project has no Redis/queue infra yet
// (Fase 4), and a TTL-checked-on-read row is sufficient for a flow that
// only ever needs to survive one browser redirect. Deleted immediately
// once consumed by the callback (single-use), or left to be ignored once
// past expiresAt (no cron sweeps expired rows yet — harmless clutter, not
// a correctness issue, since expiry is always checked on read).
model GithubInstallIntent {
  state          String                @id
  organizationId String
  userId         String
  returnTo       GithubInstallReturnTo
  expiresAt      DateTime

  createdAt DateTime @default(now())

  @@map("github_install_intents")
}

enum GithubInstallReturnTo {
  SETUP
  SETTINGS
}

model Repository {
  id             String   @id @default(cuid())
  organizationId String
  integrationId  String
  provider       Provider
  externalId     String
  path           String
  defaultBranch  String

  // GitLab-only — a hook is registered per-repo via the GitLab API when the
  // repo is connected (see ReposService.createRepos). Null until that call
  // succeeds, and always null for provider = GITHUB: GitHub App webhooks are
  // App-wide (configured once in the App's own dashboard), never per-repo,
  // so there is no per-row hook id/secret to store for that provider.
  gitlabWebhookId        Int?
  encryptedWebhookSecret String? @db.Text

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  scanConfig     RepoScanConfig?
  branchPolicies BranchScanPolicy[]
  pullRequests   PullRequest[]
  scans              Scan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // integrationId already implies organizationId (an Integration belongs to
  // exactly one org) — sufficient without repeating organizationId here.
  @@unique([integrationId, externalId])
  @@index([organizationId])
  @@map("repositories")
}

// Scan scope (D6, PRD v1.4.2) — which branches' PR/MR webhooks are actually
// processed for this repo. Deliberately separate from BranchScanPolicy
// (review mode per branch): scope answers "do we scan this branch at all",
// policy answers "how do we review it once scanned". defaultBranch is a
// snapshot taken from the provider at connect time — never assumed "main".
model RepoScanConfig {
  id                     String    @id @default(cuid())
  organizationId         String
  repositoryId           String    @unique
  defaultBranch          String
  branches               String[]
  defaultBranchChangedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, repositoryId])
  @@map("repo_scan_configs")
}

// Review mode per monitored branch — one row per branch in RepoScanConfig's
// scope. Kept separate from RepoScanConfig itself (D6) so scope changes
// (adding/removing a monitored branch) don't require rewriting policy data
// for branches that stay in scope.
model BranchScanPolicy {
  id             String       @id @default(cuid())
  organizationId String
  repositoryId   String
  branch         String
  policy         ReviewPolicy

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, branch])
  @@index([organizationId])
  @@map("branch_scan_policies")
}

enum ReviewPolicy {
  MANUAL_ONLY
  ALLOW_AI
  REQUIRE_BOTH
}

// Provider-agnostic PR/MR state — GitHub's `state` (open/closed) + `merged`
// boolean and GitLab's `state` (opened/closed/merged/locked) collapse into
// this single 3-value enum so the FE never has to branch on provider.
// GitLab `locked` maps to OPEN — locking only blocks new discussion, it
// isn't a terminal PR status. See PullsService's mapPayload for the exact
// per-provider mapping.
enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

enum ScanStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  SUPERSEDED
}

enum ScanTrigger {
  WEBHOOK
  MANUAL
  RESCAN
}

enum ScanErrorCode {
  PROVIDER_UNREACHABLE
  DIFF_TOO_LARGE
  TIMEOUT
  RULE_CRASH
  TOKEN_EXPIRED
}

enum FindingSeverity {
  CRITICAL
  MAJOR
  MINOR
  INFO
}

enum FindingSource {
  STATIC
  AI
}


// One row per PR/MR, upserted from webhook events only (WebhooksService) —
// no polling/pull path exists. Deliberately GET-only at this phase (Fase
// 3): no review/approve fields here, that's the separate `reviews` module
// later. organizationId is denormalized (same rationale as Repository/
// RepoScanConfig/BranchScanPolicy) so tenant-scoped queries never need a
// join to enforce isolation.
model PullRequest {
  id             String            @id @default(cuid())
  organizationId String
  repositoryId   String
  provider       Provider
  externalId     String
  title          String
  authorUsername String?
  sourceBranch   String
  targetBranch   String
  headSha        String?
  state          PullRequestState

  // Denormalized pointer to the most recent Scan that reached a terminal
  // state (DONE or FAILED) for this PR — updated only on those transitions,
  // never on QUEUED/RUNNING, so list views always show the last valid
  // result while an in-flight scan is surfaced separately as `activeScan`
  // (computed at query time, not stored).
  latestScanId String?

  // Snapshot of the BranchScanPolicy matching targetBranch at the moment
  // this row was first created (PR opened) — NEVER re-read on update. If
  // BranchScanPolicy for this branch changes later, this PR keeps showing
  // the policy in effect when it was opened (audit integrity, CLAUDE.md
  // "Prioritas policy"). Falls back to MANUAL_ONLY in the defensive case
  // where no matching BranchScanPolicy row exists — should not happen in
  // the normal flow, since every monitored branch gets a BranchScanPolicy
  // row in ReposService.createRepos.
  effectivePolicy ReviewPolicy

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  latestScan   Scan?        @relation("PullRequestLatestScan", fields: [latestScanId], references: [id], onDelete: SetNull)

  // Every Scan row ever created for this PR (all attempts, all statuses) —
  // reverse side of Scan.pullRequest. Distinct from `latestScan` above,
  // which points at just one of these (the most recent terminal one).
  scans Scan[] @relation("ScanPullRequest")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Repeated webhook events (opened, then synchronize, then closed) for
  // the same PR/MR must upsert the same row, never duplicate it.
  @@unique([repositoryId, externalId])
  @@index([organizationId])
  @@map("pull_requests")
}

// One row per scan attempt on a PR/MR's diff. `attempt` + the unique
// constraint below let a manual/rescan trigger insert a fresh row for the
// same headSha (attempt+1) without colliding with the original webhook-
// triggered scan for that sha. organizationId is denormalized for the same
// tenant-isolation reason as every other model here — no join needed to
// enforce it.
model Scan {
  id             String        @id @default(cuid())
  organizationId String
  repositoryId   String
  pullId         String
  headSha        String
  baseSha        String?
  status         ScanStatus
  trigger        ScanTrigger
  attempt        Int           @default(1)
  errorCode      ScanErrorCode?
  errorMessage   String?       @db.Text
  diffBytes      Int?
  filesChanged   Int?
  findingsCount  Int           @default(0)
  criticalCount  Int           @default(0)

  // Static rules snapshot at scan time (RulesModule's RULESET_VERSION) —
  // kept even though only one ruleset version exists today, so a future
  // ruleset change doesn't leave old scans looking like they used rules
  // that didn't exist yet when they actually ran.
  rulesetVersion String

  // True once findings for this scan hit the 500-per-scan cap (see
  // ScansModule) — the first 500 are still persisted, this just tells the
  // FE "there were more."
  findingsTruncated Boolean @default(false)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pullRequest  PullRequest  @relation("ScanPullRequest", fields: [pullId], references: [id], onDelete: Cascade)
  findings     Finding[]

  // Reverse side of PullRequest.latestScanId — a Scan doesn't reference
  // "its" PullRequest.latestScanId directly (that would be circular); this
  // is just what Prisma requires to model the relation named above on
  // PullRequest.
  latestForPullRequests PullRequest[] @relation("PullRequestLatestScan")

  @@unique([repositoryId, pullId, headSha, attempt])
  @@index([organizationId, pullId, createdAt(sort: Desc)])
  @@map("scans")
}

// One row per rule hit within a scan. `fingerprint` lets the processor
// dedupe repeated hits of the same issue within one scan (see RulesModule)
// — it is not used for cross-scan dedup/suppression in this release.
model Finding {
  id             String          @id @default(cuid())
  organizationId String
  scanId         String
  source         FindingSource
  ruleId         String
  severity       FindingSeverity
  title          String          @db.VarChar(120)
  message        String          @db.Text
  filePath       String
  lineStart      Int
  lineEnd        Int

  // Redacted to null for secret.* rules — the raw matched text (an actual
  // credential) must never be persisted, even to a security-review UI.
  snippet String? @db.Text

  fingerprint String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([organizationId, scanId])
  @@index([scanId, filePath, lineStart])
  @@map("findings")
}




