// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique @db.VarChar(100)
  name      String? @db.VarChar(100)
  avatarUrl String?

  accounts              Account[]
  memberships           Membership[]
  createdOrgs           Organization[] @relation("OrganizationCreatedBy")
  connectedIntegrations Integration[]  @relation("IntegrationConnectedBy")
  aiConsentOrgs         Organization[] @relation("OrganizationAiConsentBy")
  updatedAiCredentials  AiCredential[] @relation("AiCredentialUpdatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Organization {
  id                  String  @id @default(cuid())
  name                String  @db.VarChar(100)
  slug                String  @unique @db.VarChar(100)
  createdBy           String
  onboardingCompleted Boolean @default(false)

  creator            User               @relation("OrganizationCreatedBy", fields: [createdBy], references: [id])
  memberships        Membership[]
  integrations       Integration[]
  repositories       Repository[]
  repoScanConfigs    RepoScanConfig[]
  branchScanPolicies BranchScanPolicy[]
  pullRequests       PullRequest[]
  scans              Scan[]
  findings           Finding[]
  aiCredentials      AiCredential[]
  aiUsageDaily       AiUsageDaily[]
  aiSummaries        AiSummary[]

  // AI provider (v1.5.1 langkah 1). The active provider/model; credentials
  // live per provider in ai_credentials so switching back and forth never
  // drops a key. No consent = step 2 never sends a diff anywhere.
  aiProvider         AiProviderId?
  aiModel            String?
  aiConsentAt        DateTime?
  aiConsentBy        String?
  aiConsentUser      User?         @relation("OrganizationAiConsentBy", fields: [aiConsentBy], references: [id], onDelete: SetNull)
  aiLocale           String        @default("en")
  aiDailyTokenBudget Int           @default(2000000)
  // Result of the last "Test connection" — shown back in GET settings/ai.
  aiLastTest         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role             @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  lastAccessedAt DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

enum MembershipStatus {
  ACTIVE
  INVITED
}

enum Role {
  ADMIN
  REVIEWER
  VIEWER
}

model Account {
  id                String   @id @default(cuid())
  provider          Provider
  providerAccountId String
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  userId            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

enum Provider {
  GITHUB
  GITLAB
}

model Integration {
  id             String           @id @default(cuid())
  organizationId String
  source         Provider
  credentialKind CredentialKind   @default(GROUP_TOKEN)
  state          IntegrationState @default(ACTIVE)

  // --- GitLab-only fields — nullable, unused when source = GITHUB ---
  instanceUrl    String?    @db.Text
  encryptedToken String?    @db.Text
  expiresAt      DateTime?
  tokenKind      TokenKind?
  tokenUsername  String?    @db.Text
  groupsCache    Json?

  // --- GitHub App-only fields — nullable, unused when source = GITLAB ---
  // installationId is the durable credential here: there is no per-org
  // secret to store, just this id + the one shared App private key (env
  // config) needed to mint short-lived installation access tokens on demand.
  installationId    String? @unique
  installationLogin String? @db.Text
  appSlug           String? @db.Text

  connectedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?        @relation("IntegrationConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  repositories Repository[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, source])
  @@map("integrations")
}

enum CredentialKind {
  GROUP_TOKEN
  OAUTH
  INSTALLATION
}

enum TokenKind {
  GROUP
  PERSONAL
}

enum IntegrationState {
  ACTIVE
  EXPIRING_SOON
  TOKEN_EXPIRED
  INVALID
  // GitHub App installation only: the org's GitHub restricts installs to
  // owners, a non-owner requested install, and a separate GitHub-side
  // owner approval is still pending. No webhook ingestion exists yet
  // (Fase 4) to detect that approval automatically — this state persists
  // until an admin re-runs the install flow after approval.
  PENDING_APPROVAL
}

// Short-lived, single-use record bridging the GitHub App installation
// redirect round trip (Critiq -> github.com -> Critiq callback). Stored in
// Postgres rather than Redis — this project has no Redis/queue infra yet
// (Fase 4), and a TTL-checked-on-read row is sufficient for a flow that
// only ever needs to survive one browser redirect. Deleted immediately
// once consumed by the callback (single-use), or left to be ignored once
// past expiresAt (no cron sweeps expired rows yet — harmless clutter, not
// a correctness issue, since expiry is always checked on read).
model GithubInstallIntent {
  state          String                @id
  organizationId String
  userId         String
  returnTo       GithubInstallReturnTo
  expiresAt      DateTime

  createdAt DateTime @default(now())

  @@map("github_install_intents")
}

enum GithubInstallReturnTo {
  SETUP
  SETTINGS
}

model Repository {
  id             String   @id @default(cuid())
  organizationId String
  integrationId  String
  provider       Provider
  externalId     String
  path           String
  defaultBranch  String

  // GitLab-only — a hook is registered per-repo via the GitLab API when the
  // repo is connected (see ReposService.createRepos). Null until that call
  // succeeds, and always null for provider = GITHUB: GitHub App webhooks are
  // App-wide (configured once in the App's own dashboard), never per-repo,
  // so there is no per-row hook id/secret to store for that provider.
  gitlabWebhookId        Int?
  encryptedWebhookSecret String? @db.Text

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  scanConfig     RepoScanConfig?
  branchPolicies BranchScanPolicy[]
  pullRequests   PullRequest[]
  scans          Scan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // integrationId already implies organizationId (an Integration belongs to
  // exactly one org) — sufficient without repeating organizationId here.
  @@unique([integrationId, externalId])
  @@index([organizationId])
  @@map("repositories")
}

// Scan scope (D6, PRD v1.4.2) — which branches' PR/MR webhooks are actually
// processed for this repo. Deliberately separate from BranchScanPolicy
// (review mode per branch): scope answers "do we scan this branch at all",
// policy answers "how do we review it once scanned". defaultBranch is a
// snapshot taken from the provider at connect time — never assumed "main".
model RepoScanConfig {
  id                     String    @id @default(cuid())
  organizationId         String
  repositoryId           String    @unique
  defaultBranch          String
  branches               String[]
  defaultBranchChangedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, repositoryId])
  @@map("repo_scan_configs")
}

// Review mode per monitored branch — one row per branch in RepoScanConfig's
// scope. Kept separate from RepoScanConfig itself (D6) so scope changes
// (adding/removing a monitored branch) don't require rewriting policy data
// for branches that stay in scope.
model BranchScanPolicy {
  id             String       @id @default(cuid())
  organizationId String
  repositoryId   String
  branch         String
  policy         ReviewPolicy

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, branch])
  @@index([organizationId])
  @@map("branch_scan_policies")
}

enum ReviewPolicy {
  MANUAL_ONLY
  ALLOW_AI
  REQUIRE_BOTH
}

// Provider-agnostic PR/MR state — GitHub's `state` (open/closed) + `merged`
// boolean and GitLab's `state` (opened/closed/merged/locked) collapse into
// this single 3-value enum so the FE never has to branch on provider.
// GitLab `locked` maps to OPEN — locking only blocks new discussion, it
// isn't a terminal PR status. See PullsService's mapPayload for the exact
// per-provider mapping.
enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

enum ScanStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  SUPERSEDED
}

enum ScanTrigger {
  WEBHOOK
  MANUAL
  RESCAN
}

enum ScanErrorCode {
  PROVIDER_UNREACHABLE
  DIFF_TOO_LARGE
  TIMEOUT
  RULE_CRASH
  TOKEN_EXPIRED
}

enum FindingSeverity {
  CRITICAL
  MAJOR
  MINOR
  INFO
}

enum FindingSource {
  STATIC
  AI
}

// Why a finding was stored but not counted (see src/queue/suppression.ts).
// Suppressed findings stay visible to Admins — a real secret in a test file
// must not vanish — but never reach criticalCount, notifications or diff
// annotations.
enum SuppressionReason {
  TEST_FILE
  REGEX_LITERAL
  // Last, not in priority order: Postgres ADD VALUE appends, and keeping the
  // schema in the same order avoids a spurious diff. Priority lives in
  // classifySuppression (test_file > comment > regex_literal).
  COMMENT
  // An AI finding duplicating a static one, kept only with AI_KEEP_DEDUPED.
  DEDUPE_STATIC
}

// One row per PR/MR, upserted from webhook events only (WebhooksService) —
// no polling/pull path exists. Deliberately GET-only at this phase (Fase
// 3): no review/approve fields here, that's the separate `reviews` module
// later. organizationId is denormalized (same rationale as Repository/
// RepoScanConfig/BranchScanPolicy) so tenant-scoped queries never need a
// join to enforce isolation.
model PullRequest {
  id             String           @id @default(cuid())
  organizationId String
  repositoryId   String
  provider       Provider
  externalId     String
  title          String
  // PR/MR body from the webhook — context for the AI review prompt
  // (truncated there to 2000 characters). Null for PRs last seen before
  // v1.5.1.
  description    String?          @db.Text
  authorUsername String?
  sourceBranch   String
  targetBranch   String
  headSha        String?
  state          PullRequestState

  // Denormalized pointer to the most recent Scan that reached a terminal
  // state (DONE or FAILED) for this PR — updated only on those transitions,
  // never on QUEUED/RUNNING, so list views always show the last valid
  // result while an in-flight scan is surfaced separately as `activeScan`
  // (computed at query time, not stored).
  latestScanId String?

  // Snapshot of the BranchScanPolicy matching targetBranch at the moment
  // this row was first created (PR opened) — NEVER re-read on update. If
  // BranchScanPolicy for this branch changes later, this PR keeps showing
  // the policy in effect when it was opened (audit integrity, CLAUDE.md
  // "Prioritas policy"). Falls back to MANUAL_ONLY in the defensive case
  // where no matching BranchScanPolicy row exists — should not happen in
  // the normal flow, since every monitored branch gets a BranchScanPolicy
  // row in ReposService.createRepos.
  effectivePolicy ReviewPolicy

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  latestScan   Scan?        @relation("PullRequestLatestScan", fields: [latestScanId], references: [id], onDelete: SetNull)

  // Every Scan row ever created for this PR (all attempts, all statuses) —
  // reverse side of Scan.pullRequest. Distinct from `latestScan` above,
  // which points at just one of these (the most recent terminal one).
  scans Scan[] @relation("ScanPullRequest")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Repeated webhook events (opened, then synchronize, then closed) for
  // the same PR/MR must upsert the same row, never duplicate it.
  findings Finding[]

  @@unique([repositoryId, externalId])
  @@index([organizationId])
  @@map("pull_requests")
}

// One row per scan attempt on a PR/MR's diff. `attempt` + the unique
// constraint below let a manual/rescan trigger insert a fresh row for the
// same headSha (attempt+1) without colliding with the original webhook-
// triggered scan for that sha. organizationId is denormalized for the same
// tenant-isolation reason as every other model here — no join needed to
// enforce it.
model Scan {
  id             String         @id @default(cuid())
  organizationId String
  repositoryId   String
  pullId         String
  headSha        String
  baseSha        String?
  status         ScanStatus
  trigger        ScanTrigger
  attempt        Int            @default(1)
  errorCode      ScanErrorCode?
  errorMessage   String?        @db.Text
  diffBytes      Int?
  filesChanged   Int?
  findingsCount  Int            @default(0)
  criticalCount  Int            @default(0)

  // Static rules snapshot at scan time (RulesModule's RULESET_VERSION) —
  // kept even though only one ruleset version exists today, so a future
  // ruleset change doesn't leave old scans looking like they used rules
  // that didn't exist yet when they actually ran.
  rulesetVersion String

  // True once findings for this scan hit the 500-per-scan cap (see
  // ScansModule) — the first 500 are still persisted, this just tells the
  // FE "there were more."
  findingsTruncated Boolean @default(false)

  // Suppressed findings, counted separately from findingsCount/criticalCount
  // (which are active-only). Capped at 200 stored rows per scan; the count is
  // the real total before the cap.
  suppressedCount     Int     @default(0)
  suppressedTruncated Boolean @default(false)

  // AI review (v1.5.1 langkah 2). aiStatus null = the AI step never
  // evaluated this scan (created before v1.5.1, or static FAILED).
  // criticalCount above includes AI criticals once the AI step is DONE;
  // majorCount/minorCount are AI-only (static rules are Critical-only).
  aiStatus           AiScanStatus?
  aiErrorCode        String?
  aiProvider         String?
  aiModel            String?
  aiPromptVersion    String?
  aiTokensIn         Int?
  aiTokensOut        Int?
  aiCached           Boolean       @default(false)
  aiStartedAt        DateTime?
  aiFinishedAt       DateTime?
  aiFindingsTotal    Int           @default(0)
  aiFindingsRejected Int           @default(0)
  aiFindingsDeduped  Int           @default(0)
  majorCount         Int           @default(0)
  minorCount         Int           @default(0)
  aiFlags            String[]      @default([])
  // Redis key of the encrypted raw provider response, kept 30 days — only
  // when the response was invalid (debugging). On the scan, not the summary:
  // an invalid response is exactly the case with no summary row.
  aiRawRef           String?

  // Lifecycle (v1.5.1 langkah 3). INCREMENTAL = only the diff
  // prevHeadSha → headSha was scanned; findings of baseScanId were carried
  // forward. fullReason says why a scan was FULL.
  diffMode       DiffMode    @default(FULL)
  fullReason     FullReason?
  baseScanId     String?
  prevHeadSha    String?
  newCount       Int         @default(0)
  persistedCount Int         @default(0)
  reopenedCount  Int         @default(0)
  resolvedCount  Int         @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pullRequest  PullRequest  @relation("ScanPullRequest", fields: [pullId], references: [id], onDelete: Cascade)
  findings     Finding[]

  // Reverse side of PullRequest.latestScanId — a Scan doesn't reference
  // "its" PullRequest.latestScanId directly (that would be circular); this
  // is just what Prisma requires to model the relation named above on
  // PullRequest.
  latestForPullRequests PullRequest[] @relation("PullRequestLatestScan")
  aiSummary             AiSummary?
  baseScan              Scan?         @relation("ScanBase", fields: [baseScanId], references: [id], onDelete: SetNull)
  derivedScans          Scan[]        @relation("ScanBase")
  firstSeenFindings     Finding[]     @relation("FindingFirstSeen")
  resolvedFindings      Finding[]     @relation("FindingResolvedIn")

  @@unique([repositoryId, pullId, headSha, attempt])
  @@index([organizationId, pullId, createdAt(sort: Desc)])
  @@map("scans")
}

// One row per rule hit within a scan. `fingerprint` lets the processor
// dedupe repeated hits of the same issue within one scan (see RulesModule)
// — it is not used for cross-scan dedup/suppression in this release.
model Finding {
  id             String          @id @default(cuid())
  organizationId String
  scanId         String
  source         FindingSource
  ruleId         String
  severity       FindingSeverity
  title          String          @db.VarChar(120)
  message        String          @db.Text
  filePath       String
  lineStart      Int
  lineEnd        Int

  // Redacted to null for secret.* rules — the raw matched text (an actual
  // credential) must never be persisted, even to a security-review UI.
  snippet String? @db.Text

  fingerprint String

  // null = active finding. Set = stored for visibility only, excluded from
  // every count, notification and annotation.
  suppressedReason SuppressionReason?

  // Shared vocabulary for static and AI findings, used to dedupe one against
  // the other. Nullable only for rows the migration backfill could not map.
  category   FindingCategory?
  // AI only, 0.00–1.00 as the model reported it.
  confidence Decimal?         @db.Decimal(3, 2)
  // AI finding kept although it duplicates this static finding
  // (AI_KEEP_DEDUPED=true, suppressedReason DEDUPE_STATIC).
  dedupeOfId String?

  // Lifecycle (v1.5.1 langkah 3). pullId is denormalized from the scan so
  // lifecycle queries across a PR's scans stay cheap. A RESOLVED row lives
  // in the scan that closed it; originFindingId points at the finding it
  // continues (PERSISTED/REOPENED) or closes (RESOLVED).
  pullId           String
  status           FindingStatus @default(NEW)
  firstSeenScanId  String
  resolvedInScanId String?
  originFindingId  String?

  createdAt DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan          Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  dedupeOf      Finding?     @relation("FindingDedupeOf", fields: [dedupeOfId], references: [id], onDelete: SetNull)
  duplicates    Finding[]    @relation("FindingDedupeOf")
  pullRequest   PullRequest  @relation(fields: [pullId], references: [id], onDelete: Cascade)
  firstSeenIn   Scan         @relation("FindingFirstSeen", fields: [firstSeenScanId], references: [id], onDelete: Cascade)
  resolvedIn    Scan?        @relation("FindingResolvedIn", fields: [resolvedInScanId], references: [id], onDelete: SetNull)
  origin        Finding?     @relation("FindingOrigin", fields: [originFindingId], references: [id], onDelete: SetNull)
  continuations Finding[]    @relation("FindingOrigin")

  @@index([organizationId, scanId])
  @@index([scanId, filePath, lineStart])
  @@index([organizationId, pullId, fingerprint, status])
  @@index([organizationId, pullId, status])
  @@map("findings")
}

enum AiProviderId {
  ANTHROPIC
  OPENAI
  OPENAI_COMPATIBLE
}

// One organization-owned credential per provider (v1.5.1 langkah 1).
// encryptedKey is EncryptionService output (AES-256-GCM, `iv:tag:ct` hex,
// ENCRYPTION_KEY) — never returned by the API, only keyLast4 is. Null only
// for openai_compatible, where a self-hosted server may need no key.
model AiCredential {
  organizationId String
  provider       AiProviderId
  encryptedKey   String?
  keyLast4       String?      @db.VarChar(4)
  // Which ENCRYPTION_KEY generation encrypted this row; rotation is out of
  // scope, but recording it now means a rotation needs no schema change.
  keyVersion     Int          @default(1)
  baseUrl        String?
  updatedBy      String?
  updatedAt      DateTime     @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser User?        @relation("AiCredentialUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@id([organizationId, provider])
  @@map("ai_credentials")
}

enum AiUsageKind {
  SCAN
  TEST
}

// Token usage per organization per day. TEST rows (Settings → Test
// connection) never count toward aiDailyTokenBudget; SCAN rows do (step 2).
model AiUsageDaily {
  organizationId String
  day            DateTime    @db.Date
  kind           AiUsageKind
  calls          Int         @default(0)
  inputTokens    Int         @default(0)
  outputTokens   Int         @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, day, kind])
  @@map("ai_usage_daily")
}

enum FindingCategory {
  SECRET
  INJECTION
  INSECURE_TLS
  ERROR_HANDLING
  PERFORMANCE
  LOGIC
  AUTH
  CONCURRENCY
  DATA_LOSS
  CONFIG
  OTHER
}

enum AiScanStatus {
  QUEUED
  RUNNING
  DONE
  CACHED
  FAILED
  SKIPPED_MANUAL_MODE
  CONSENT_REQUIRED
  NOT_CONFIGURED
  SKIPPED_TOO_LARGE
  BUDGET_EXCEEDED
}

enum AiRiskLevel {
  LOW
  MEDIUM
  HIGH
}

// The AI review of one scan (v1.5.1 langkah 2). One per scan; a cache hit
// copies the source scan's summary into a new row for the new scan.
model AiSummary {
  id             String      @id @default(cuid())
  organizationId String
  scanId         String      @unique
  pullId         String
  summaryMd      String      @db.Text
  riskLevel      AiRiskLevel
  filesOmitted   String[]    @default([])
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan         Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([organizationId, pullId])
  @@map("ai_summaries")
}

enum DiffMode {
  FULL
  INCREMENTAL
}

enum FullReason {
  FIRST_SCAN
  FORCE_PUSH
  RULESET_CHANGED
  PROMPT_CHANGED
  MANUAL
}

enum FindingStatus {
  NEW
  PERSISTED
  REOPENED
  RESOLVED
}
